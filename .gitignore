# Generated by build.py on every build, including in CI — no reason to carry
# a second copy of the app in the repository that can drift from index.html.
desktop/dist/
desktop/src-tauri/target/
desktop/src-tauri/gen/
node_modules/
# Local developer settings, such as the MOTOR sandbox keys for testmotorlive.cjs.
# Credentials never belong in this repository.
*.env
.env*
