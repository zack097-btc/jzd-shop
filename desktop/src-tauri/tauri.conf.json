{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JZD Shop Manager",
  "version": "2.4.0",
  "identifier": "com.jzacdesigns.jzdshop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "JZac Designs",
    "copyright": "Copyright (c) 2026 JZac Designs",
    "category": "Business",
    "shortDescription": "Automotive shop manager",
    "longDescription": "JZD Shop Manager — customers, vehicles, work orders, invoices and catalogs. Every record is written to a real file on this machine; no account, no internet, no subscription.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
